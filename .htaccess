# GLG · Đường dẫn gọn (Apache / LiteSpeed trên cPanel)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Ép HTTPS: CHỈ bật sau khi AutoSSL đã cấp chứng chỉ cho glg.danava.com.vn ---
# Bỏ dấu # ở 2 dòng dưới để bật.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Địa chỉ cũ → địa chỉ mới (để link đã gửi khách vẫn dùng được) ---
RewriteRule ^ca-phe(/.*)?$ /cafe/ [R=301,L]
RewriteRule ^marriott/?(index\.html)?$ /khach-san/ [R=301,L]
RewriteRule ^marriott/(.+)$ /khach-san/$1 [R=301,L]

# --- Ẩn "index.html" trên thanh địa chỉ: /cafe/index.html → /cafe/ ---
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Không cho tải các file cấu hình triển khai
<FilesMatch "^(\.cpanel\.yml|DEPLOY\.md|README\.md)$">
  Require all denied
</FilesMatch>
